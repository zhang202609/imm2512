# ============================================================================
# Honor FUR-602 —— 追加到
#   target/linux/mediatek/image/filogic.mk
# 末尾（TARGET_DEVICES 之前任意位置均可，建议放在 honor_* 字母序位置）
#
# 布局：hanwckf U-Boot expand(114m) —— ubi 0x580000 + 0x7200000 (114MiB)
# 产物：xxx-mediatek-filogic-honor_fur-602-squashfs-factory.bin   (U-Boot 首次刷入)
#       xxx-mediatek-filogic-honor_fur-602-squashfs-sysupgrade.bin (系统内升级)
#       xxx-mediatek-filogic-honor_fur-602-initramfs-kernel.itb    (内存版试机)
# ============================================================================

define Device/honor_fur-602
  DEVICE_VENDOR := Honor
  DEVICE_MODEL := FUR-602
  DEVICE_ALT0_VENDOR := Honor
  DEVICE_ALT0_MODEL := XT50 / XU50 / XC50
  DEVICE_DTS := mt7981b-honor-fur-602
  DEVICE_DTS_DIR := ../dts
  DEVICE_PACKAGES := kmod-mt7915e kmod-mt7981-firmware mt7981-wo-firmware
  UBINIZE_OPTS := -E 5
  BLOCKSIZE := 128k
  PAGESIZE := 2048
  KERNEL_IN_UBI := 1
  IMAGES += factory.bin
  IMAGE_SIZE := 116736k
  IMAGE/factory.bin := append-ubi | check-size $$$$(IMAGE_SIZE)
  IMAGE/sysupgrade.bin := sysupgrade-tar | append-metadata
  SUPPORTED_DEVICES += honor,fur-602
endef
TARGET_DEVICES += honor_fur-602

# ---------------------------------------------------------------------------
